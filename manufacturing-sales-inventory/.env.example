# Copy this file to backend/.env and fill in your local values.

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manufacturing_db?schema=public

# Secret used to sign JWT tokens (use any long random string locally)
JWT_SECRET=change_this_to_a_long_random_string

# Port the Express backend listens on
PORT=4000

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
