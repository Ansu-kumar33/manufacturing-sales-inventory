// Prisma schema - Manufacturing Sales & Inventory Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  company   String
  contact   String
  mobile    String
  email     String   @unique
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
}

model Product {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  category  String
  unit      String
  basePrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique
  physicalQty Int      @default(0)
  reservedQty Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model Enquiry {
  id           Int           @id @default(autoincrement())
  enquiryNo    String        @unique
  customerId   Int
  enquiryDate  DateTime      @default(now())
  requiredDate DateTime?
  notes        String?
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id])
  items      EnquiryItem[]
  quotations Quotation[]
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Quotation {
  id          Int             @id @default(autoincrement())
  quotationNo String          @unique
  enquiryId   Int?
  customerId  Int
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  totalAmount Decimal         @default(0) @db.Decimal(14, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  enquiry    Enquiry?        @relation(fields: [enquiryId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  items      QuotationItem[]
  salesOrder SalesOrder?
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  gstPct      Decimal @default(0) @db.Decimal(5, 2)
  lineAmount  Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNo     String           @unique
  customerId  Int
  quotationId Int              @unique
  orderDate   DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(14, 2)
  status      SalesOrderStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  quotation Quotation        @relation(fields: [quotationId], references: [id])
  items     SalesOrderItem[]
  dispatch  Dispatch?
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  lineAmount   Decimal @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

model Dispatch {
  id           Int      @id @default(autoincrement())
  dispatchNo   String   @unique
  salesOrderId Int      @unique
  dispatchDate DateTime @default(now())
  vehicleNo    String
  driverName   String
  createdAt    DateTime @default(now())

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  items      DispatchItem[]
}

model DispatchItem {
  id         Int @id @default(autoincrement())
  dispatchId Int
  productId  Int
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
}
